<mujoco model="go2 feet only">
  <!-- Unitree Go2 for MuJoCo Playground, built like go1_mjx_feetonly.xml:
       masses/inertias/kinematics from MuJoCo Menagerie unitree_go2/go2_mjx.xml,
       only the four foot spheres collide (with the floor), position actuators.
       Joint/actuator order: FR, FL, RR, RL (same as Go1 / Unitree SDK). -->
  <compiler angle="radian" meshdir="../../../../../mujoco_menagerie/unitree_go2/assets" autolimits="true"/>

  <option iterations="1" ls_iterations="5" timestep="0.004" integrator="Euler">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <default class="go2">
      <!-- This globally disables all collisions. -->
      <geom condim="1" contype="0" conaffinity="0"/>
      <joint axis="0 1 0" armature="0.01" damping="0.5" frictionloss="0.2"/>
      <!-- kp and damping are overwritten by config.Kp / config.Kd in base.py. -->
      <position forcerange="-23.7 23.7" inheritrange="1" kp="35"/>
      <default class="abduction">
        <joint axis="1 0 0" range="-1.0472 1.0472"/>
      </default>
      <default class="front_hip">
        <joint range="-1.5708 3.4907"/>
      </default>
      <default class="back_hip">
        <joint range="-0.5236 4.5379"/>
      </default>
      <default class="knee">
        <joint range="-2.7227 -0.83776" armature="0.02"/>
        <position forcerange="-45.43 45.43"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="foot">
        <!-- Feet are the only colliding geoms: contype=0, conaffinity=1 against a
             floor with contype=1, conaffinity=0, so feet hit the floor but not each other. -->
        <geom type="sphere" size="0.022" pos="-0.002 0 -0.213" solimp="0.9 .95 0.023" contype="0" conaffinity="1"
          group="3" rgba="0.231373 0.380392 0.705882 1"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="metal" rgba=".9 .95 .95 1"/>
    <material name="black" rgba="0 0 0 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.671705 0.692426 0.774270 1"/>
    <mesh class="go2" file="base_0.obj"/>
    <mesh class="go2" file="base_1.obj"/>
    <mesh class="go2" file="base_2.obj"/>
    <mesh class="go2" file="base_3.obj"/>
    <mesh class="go2" file="base_4.obj"/>
    <mesh class="go2" file="hip_0.obj"/>
    <mesh class="go2" file="hip_1.obj"/>
    <mesh class="go2" file="thigh_0.obj"/>
    <mesh class="go2" file="thigh_1.obj"/>
    <mesh class="go2" file="thigh_mirror_0.obj"/>
    <mesh class="go2" file="thigh_mirror_1.obj"/>
    <mesh class="go2" file="calf_0.obj"/>
    <mesh class="go2" file="calf_1.obj"/>
    <mesh class="go2" file="calf_mirror_0.obj"/>
    <mesh class="go2" file="calf_mirror_1.obj"/>
    <mesh class="go2" file="foot.obj"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="base" pos="3 0 4"/>
    <body name="base" pos="0 0 0.445" childclass="go2">
      <camera name="track" pos="0.846 -1.3 0.316" xyaxes="0.866 0.500 0.000 -0.171 0.296 0.940" mode="trackcom"/>
      <camera name="top" pos="-1 0 1" xyaxes="0 -1 0 0.7 0 0.7" mode="trackcom"/>
      <camera name="side" pos="0 -1 .3" xyaxes="1 0 0 0 1 2" mode="trackcom"/>
      <camera name="back" pos="-1 0 .3" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <!-- <camera name="depth_down" pos="0 0 0.5" xyaxes="0 -1 0 1 0 0" fovy="70"/> -->
      <camera name="depth_down" pos="0 0 0.5" xyaxes="1 0 0 0 1 0" projection="orthographic" fovy="0.9"/>
      <site name="head" pos="0.3 0 0" rgba="1 0 0 1" size="0.02" group="5"/>
      <inertial pos="0.021112 0 -0.005366" quat="-0.000543471 0.713435 -0.00173769 0.700719" mass="6.921"
        diaginertia="0.107027 0.0980771 0.0244531"/>
      <freejoint/>
      <geom class="visual" mesh="base_0" material="black"/>
      <geom class="visual" mesh="base_1" material="black"/>
      <geom class="visual" mesh="base_2" material="black"/>
      <geom class="visual" mesh="base_3" material="white"/>
      <geom class="visual" mesh="base_4" material="gray"/>
      <site name="imu" pos="-0.02557 0 0.04232" group="5"/>
      <body name="FR_hip" pos="0.1934 -0.0465 0">
        <inertial pos="-0.0054 -0.00194 -0.000105" quat="0.498237 0.505462 0.499245 0.497014" mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967"/>
        <joint name="FR_hip_joint" class="abduction"/>
        <geom class="visual" mesh="hip_0" material="metal" quat="4.63268e-05 1 0 0"/>
        <geom class="visual" mesh="hip_1" material="gray" quat="4.63268e-05 1 0 0"/>
        <body name="FR_thigh" pos="0 -0.0955 0">
          <inertial pos="-0.00374 0.0223 -0.0327" quat="0.551623 -0.0200632 0.0847635 0.829533" mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787"/>
          <joint name="FR_thigh_joint" class="front_hip"/>
          <geom class="visual" mesh="thigh_mirror_0" material="metal"/>
          <geom class="visual" mesh="thigh_mirror_1" material="gray"/>
          <body name="FR_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 0.000622121 -0.141417" quat="0.703508 -0.00450087 0.00154099 0.710672" mass="0.241352"
              diaginertia="0.0014901 0.00146356 5.31397e-05"/>
            <joint name="FR_calf_joint" class="knee"/>
            <geom class="visual" mesh="calf_mirror_0" material="gray"/>
            <geom class="visual" mesh="calf_mirror_1" material="black"/>
            <geom class="visual" mesh="foot" material="black" pos="0 0 -0.213"/>
            <geom name="FR" class="foot"/>
            <site name="FR_foot" pos="-0.002 0 -0.213" type="sphere" size="0.022" group="5"/>
          </body>
        </body>
      </body>
      <body name="FL_hip" pos="0.1934 0.0465 0">
        <inertial pos="-0.0054 0.00194 -0.000105" quat="0.497014 0.499245 0.505462 0.498237" mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967"/>
        <joint name="FL_hip_joint" class="abduction"/>
        <geom class="visual" mesh="hip_0" material="metal"/>
        <geom class="visual" mesh="hip_1" material="gray"/>
        <body name="FL_thigh" pos="0 0.0955 0">
          <inertial pos="-0.00374 -0.0223 -0.0327" quat="0.829533 0.0847635 -0.0200632 0.551623" mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787"/>
          <joint name="FL_thigh_joint" class="front_hip"/>
          <geom class="visual" mesh="thigh_0" material="metal"/>
          <geom class="visual" mesh="thigh_1" material="gray"/>
          <body name="FL_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 -0.000622121 -0.141417" quat="0.710672 0.00154099 -0.00450087 0.703508" mass="0.241352"
              diaginertia="0.0014901 0.00146356 5.31397e-05"/>
            <joint name="FL_calf_joint" class="knee"/>
            <geom class="visual" mesh="calf_0" material="gray"/>
            <geom class="visual" mesh="calf_1" material="black"/>
            <geom class="visual" mesh="foot" material="black" pos="0 0 -0.213"/>
            <geom name="FL" class="foot"/>
            <site name="FL_foot" pos="-0.002 0 -0.213" type="sphere" size="0.022" group="5"/>
          </body>
        </body>
      </body>
      <body name="RR_hip" pos="-0.1934 -0.0465 0">
        <inertial pos="0.0054 -0.00194 -0.000105" quat="0.499245 0.497014 0.498237 0.505462" mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967"/>
        <joint name="RR_hip_joint" class="abduction"/>
        <geom class="visual" mesh="hip_0" material="metal" quat="2.14617e-09 4.63268e-05 4.63268e-05 -1"/>
        <geom class="visual" mesh="hip_1" material="gray" quat="2.14617e-09 4.63268e-05 4.63268e-05 -1"/>
        <body name="RR_thigh" pos="0 -0.0955 0">
          <inertial pos="-0.00374 0.0223 -0.0327" quat="0.551623 -0.0200632 0.0847635 0.829533" mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787"/>
          <joint name="RR_thigh_joint" class="back_hip"/>
          <geom class="visual" mesh="thigh_mirror_0" material="metal"/>
          <geom class="visual" mesh="thigh_mirror_1" material="gray"/>
          <body name="RR_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 0.000622121 -0.141417" quat="0.703508 -0.00450087 0.00154099 0.710672" mass="0.241352"
              diaginertia="0.0014901 0.00146356 5.31397e-05"/>
            <joint name="RR_calf_joint" class="knee"/>
            <geom class="visual" mesh="calf_mirror_0" material="gray"/>
            <geom class="visual" mesh="calf_mirror_1" material="black"/>
            <geom class="visual" mesh="foot" material="black" pos="0 0 -0.213"/>
            <geom name="RR" class="foot"/>
            <site name="RR_foot" pos="-0.002 0 -0.213" type="sphere" size="0.022" group="5"/>
          </body>
        </body>
      </body>
      <body name="RL_hip" pos="-0.1934 0.0465 0">
        <inertial pos="0.0054 0.00194 -0.000105" quat="0.505462 0.498237 0.497014 0.499245" mass="0.678"
          diaginertia="0.00088403 0.000596003 0.000479967"/>
        <joint name="RL_hip_joint" class="abduction"/>
        <geom class="visual" mesh="hip_0" material="metal" quat="4.63268e-05 0 1 0"/>
        <geom class="visual" mesh="hip_1" material="gray" quat="4.63268e-05 0 1 0"/>
        <body name="RL_thigh" pos="0 0.0955 0">
          <inertial pos="-0.00374 -0.0223 -0.0327" quat="0.829533 0.0847635 -0.0200632 0.551623" mass="1.152"
            diaginertia="0.00594973 0.00584149 0.000878787"/>
          <joint name="RL_thigh_joint" class="back_hip"/>
          <geom class="visual" mesh="thigh_0" material="metal"/>
          <geom class="visual" mesh="thigh_1" material="gray"/>
          <body name="RL_calf" pos="0 0 -0.213">
            <inertial pos="0.00629595 -0.000622121 -0.141417" quat="0.710672 0.00154099 -0.00450087 0.703508" mass="0.241352"
              diaginertia="0.0014901 0.00146356 5.31397e-05"/>
            <joint name="RL_calf_joint" class="knee"/>
            <geom class="visual" mesh="calf_0" material="gray"/>
            <geom class="visual" mesh="calf_1" material="black"/>
            <geom class="visual" mesh="foot" material="black" pos="0 0 -0.213"/>
            <geom name="RL" class="foot"/>
            <site name="RL_foot" pos="-0.002 0 -0.213" type="sphere" size="0.022" group="5"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="abduction" name="FR_hip" joint="FR_hip_joint"/>
    <position class="front_hip" name="FR_thigh" joint="FR_thigh_joint"/>
    <position class="knee" name="FR_calf" joint="FR_calf_joint"/>
    <position class="abduction" name="FL_hip" joint="FL_hip_joint"/>
    <position class="front_hip" name="FL_thigh" joint="FL_thigh_joint"/>
    <position class="knee" name="FL_calf" joint="FL_calf_joint"/>
    <position class="abduction" name="RR_hip" joint="RR_hip_joint"/>
    <position class="back_hip" name="RR_thigh" joint="RR_thigh_joint"/>
    <position class="knee" name="RR_calf" joint="RR_calf_joint"/>
    <position class="abduction" name="RL_hip" joint="RL_hip_joint"/>
    <position class="back_hip" name="RL_thigh" joint="RL_thigh_joint"/>
    <position class="knee" name="RL_calf" joint="RL_calf_joint"/>
  </actuator>

  <sensor>
    <gyro site="imu" name="gyro"/>
    <velocimeter site="imu" name="local_linvel"/>
    <accelerometer site="imu" name="accelerometer"/>
    <framepos objtype="site" objname="imu" name="position"/>
    <framezaxis objtype="site" objname="imu" name="upvector"/>
    <framexaxis objtype="site" objname="imu" name="forwardvector"/>
    <framelinvel objtype="site" objname="imu" name="global_linvel"/>
    <frameangvel objtype="site" objname="imu" name="global_angvel"/>
    <framequat objtype="site" objname="imu" name="orientation"/>
    <framelinvel objtype="site" objname="FR_foot" name="FR_foot_global_linvel"/>
    <framelinvel objtype="site" objname="FL_foot" name="FL_foot_global_linvel"/>
    <framelinvel objtype="site" objname="RR_foot" name="RR_foot_global_linvel"/>
    <framelinvel objtype="site" objname="RL_foot" name="RL_foot_global_linvel"/>
    <framepos objtype="site" objname="FR_foot" name="FR_foot_pos" reftype="site" refname="imu"/>
    <framepos objtype="site" objname="FL_foot" name="FL_foot_pos" reftype="site" refname="imu"/>
    <framepos objtype="site" objname="RR_foot" name="RR_foot_pos" reftype="site" refname="imu"/>
    <framepos objtype="site" objname="RL_foot" name="RL_foot_pos" reftype="site" refname="imu"/>
  </sensor>
</mujoco>
