<mujoco model="go2 mjx + playground sensors">
  <!-- Robot: the unmodified MuJoCo Menagerie unitree_go2/go2_mjx.xml
       (loaded from the Menagerie folder by base.py, same as the meshes). -->
  <include file="go2_mjx.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <!-- priority="2" > the official foot priority="1": floor friction/condim are used for
         foot-floor contacts, so randomize.py's floor-friction randomization still works.
         For the official foot contact parameters instead (friction 0.8, condim 6),
         delete priority="2" here. -->
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0" priority="2"
      friction="0.6" condim="3"/>
  </worldbody>

  <!-- Sensors joystick.py needs that the official model does not have.
       gyro / accelerometer / global_linvel / global_angvel already exist in go2_mjx.xml. -->
  <sensor>
    <velocimeter site="imu" name="local_linvel"/>
    <framezaxis objtype="site" objname="imu" name="upvector"/>
    <framelinvel objtype="site" objname="FR_foot" name="FR_foot_global_linvel"/>
    <framelinvel objtype="site" objname="FL_foot" name="FL_foot_global_linvel"/>
    <framelinvel objtype="site" objname="RR_foot" name="RR_foot_global_linvel"/>
    <framelinvel objtype="site" objname="RL_foot" name="RL_foot_global_linvel"/>
    <framepos objtype="site" objname="FR_foot" name="FR_foot_pos" reftype="site" refname="imu"/>
    <framepos objtype="site" objname="FL_foot" name="FL_foot_pos" reftype="site" refname="imu"/>
    <framepos objtype="site" objname="RR_foot" name="RR_foot_pos" reftype="site" refname="imu"/>
    <framepos objtype="site" objname="RL_foot" name="RL_foot_pos" reftype="site" refname="imu"/>
  </sensor>

  <!-- Foot-floor contact sensors (geom names FR/FL/RR/RL are the same in the official model). -->
  <include file="sensor_feet.xml"/>

    <sensor>
    <contact name="base_floor_found"     body1="base"     geom2="floor" data="found" reduce="mindist" num="1"/>
    <contact name="FR_thigh_floor_found" body1="FR_thigh" geom2="floor" data="found" reduce="mindist" num="1"/>
    <contact name="FL_thigh_floor_found" body1="FL_thigh" geom2="floor" data="found" reduce="mindist" num="1"/>
    <contact name="RR_thigh_floor_found" body1="RR_thigh" geom2="floor" data="found" reduce="mindist" num="1"/>
    <contact name="RL_thigh_floor_found" body1="RL_thigh" geom2="floor" data="found" reduce="mindist" num="1"/>
  </sensor>

  <!-- No keyframe here: go2_mjx.xml already defines key "home"
       (z = 0.27, hips 0, thigh 0.9, calf -1.8; joint order FL, FR, RL, RR). -->
</mujoco>
